@model Estudiante
@{ ViewData["Title"] = "Estudiante"; }
<h2>@Model.NombreCompleto</h2>
<dl class="row"><dt class="col-sm-2">Carné</dt><dd class="col-sm-10">@Model.Carne</dd>
<dt class="col-sm-2">Correo</dt><dd class="col-sm-10">@Model.Correo</dd>
<dt class="col-sm-2">Carrera</dt><dd class="col-sm-10">@Model.Carrera.Nombre</dd>
<dt class="col-sm-2">Estado</dt><dd class="col-sm-10">@(Model.Activo ? "Activo" : "Inactivo")</dd></dl>
<h5>Cursos matriculados</h5>
<ul>@foreach (var m in Model.Matriculas) { <li>@m.Curso.Codigo - @m.Curso.Nombre</li> }</ul>
<a class="btn btn-secondary" asp-action="Index">Volver</a>

@model Estudiante
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="Carne" class="form-label"></label><input asp-for="Carne" class="form-control" /><span asp-validation-for="Carne" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="NombreCompleto" class="form-label"></label><input asp-for="NombreCompleto" class="form-control" /><span asp-validation-for="NombreCompleto" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Correo" class="form-label"></label><input asp-for="Correo" class="form-control" /><span asp-validation-for="Correo" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="CarreraId" class="form-label"></label>
  <select asp-for="CarreraId" asp-items="(SelectList)ViewBag.Carreras" class="form-select"><option value="">-- Seleccione --</option></select><span asp-validation-for="CarreraId" class="text-danger"></span></div>
<div class="form-check mb-3"><input asp-for="Activo" class="form-check-input" /><label asp-for="Activo" class="form-check-label">Activo</label></div>

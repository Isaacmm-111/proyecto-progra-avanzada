@model Estudiante
@{ ViewData["Title"] = "Editar estudiante"; }
<h2>Editar estudiante</h2>
<form asp-action="Edit" method="post" class="card card-body shadow-sm col-md-7">
  <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="UserId" />
  <partial name="_Form" model="Model" />
  <div><button class="btn btn-primary" type="submit">Guardar cambios</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
</form>

@model Curso
@{ ViewData["Title"] = "Eliminar curso"; }
<h2>Eliminar curso</h2>
<div class="alert alert-warning">¿Seguro que desea eliminar el curso <strong>@Model.Codigo - @Model.Nombre</strong>? (Matriculados: @Model.Matriculas.Count)</div>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" />
  <button class="btn btn-danger" type="submit">Eliminar</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></form>

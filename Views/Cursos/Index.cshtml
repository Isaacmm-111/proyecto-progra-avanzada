@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<Curso>
@{ ViewData["Title"] = "Cursos"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Cursos</h2><a class="btn btn-primary" asp-action="Create">Nuevo curso</a></div>
<form method="get" class="row g-2 mb-3">
  <div class="col-md-4"><input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por código o nombre" /></div>
  <div class="col-md-4"><select name="carreraId" asp-items="(SelectList)ViewBag.Carreras" class="form-select"><option value="">Todas las carreras</option></select></div>
  <div class="col-auto"><button class="btn btn-outline-primary">Filtrar</button></div>
</form>
<div class="table-responsive"><table class="table table-striped bg-white align-middle">
<thead><tr><th>Código</th><th>Nombre</th><th>Carrera</th><th>Cuatri.</th><th>Créd.</th><th>Docente</th><th>Horario</th><th>Cupos</th><th></th></tr></thead>
<tbody>
@foreach (var c in Model)
{
  <tr><td>@c.Codigo</td><td>@c.Nombre</td><td>@c.Carrera?.Codigo</td><td>@c.Cuatrimestre</td><td>@c.Creditos</td>
  <td>@(c.Docente?.Nombre ?? "Sin asignar")</td><td>@(c.Horario ?? "-")</td><td>@c.CuposDisponibles / @c.CupoMaximo</td>
  <td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
      <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@c.Id">Eliminar</a></td></tr>
}
</tbody></table></div>

@model Carrera
@{ ViewData["Title"] = "Editar carrera"; }
<h2>Editar carrera</h2>
<form asp-action="Edit" method="post" class="card card-body shadow-sm col-md-6">
  <input type="hidden" asp-for="Id" />
  <partial name="_Form" model="Model" />
  <div><button class="btn btn-primary" type="submit">Guardar cambios</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></div>
</form>

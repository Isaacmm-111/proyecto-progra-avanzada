@{
    bool esAdmin = User.IsInRole("Administrador");
    string Activo(string ctrl) => (ViewContext.RouteData.Values["controller"]?.ToString() == ctrl) ? "active" : "";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MatrículaU</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container-fluid px-4">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">MatrículaU</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="menu">
                <ul class="navbar-nav me-auto">
                    @if (User.IsInRole("Estudiante"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="Index">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="MiCarrera">Mi carrera</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="Matricular">Matricular cursos</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Estudiante" asp-action="MiMatricula">Mi matrícula</a></li>
                    }
                </ul>
                <ul class="navbar-nav align-items-lg-center">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item"><span class="navbar-text me-3">@(esAdmin ? "Admin" : User.IsInRole("Docente") ? "Docente" : "Estudiante") · @User.Identity.Name</span></li>
                        <li class="nav-item">
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="btn btn-outline-light btn-sm" type="submit">Cerrar sesión</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar sesión</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Register">Registrarse</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid px-4 pb-5">
        <div class="row">
            @if (esAdmin)
            {
                <aside class="col-lg-2 mb-4">
                    <div class="list-group shadow-sm">
                        <a class="list-group-item list-group-item-action @Activo("Admin")" asp-controller="Admin" asp-action="Index">Dashboard</a>
                        <a class="list-group-item list-group-item-action @Activo("Estudiantes")" asp-controller="Estudiantes" asp-action="Index">Estudiantes</a>
                        <a class="list-group-item list-group-item-action @Activo("Carreras")" asp-controller="Carreras" asp-action="Index">Carreras</a>
                        <a class="list-group-item list-group-item-action @Activo("Cursos")" asp-controller="Cursos" asp-action="Index">Cursos</a>
                        <a class="list-group-item list-group-item-action @Activo("Docentes")" asp-controller="Docentes" asp-action="Index">Docentes</a>
                        <a class="list-group-item list-group-item-action @Activo("Matriculas")" asp-controller="Matriculas" asp-action="Index">Matrículas</a>
                        <a class="list-group-item list-group-item-action @Activo("Configuracion")" asp-controller="Configuracion" asp-action="Index">Periodo y usuarios</a>
                    </div>
                </aside>
            }
            <main class="@(esAdmin ? "col-lg-10" : "col-12 container")">
                @if (TempData["Ok"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show">@TempData["Ok"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="text-center text-muted py-3 border-top">&copy; 2026 MatrículaU - Sistema de Matrícula Universitaria · Universidad Fidélitas</footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.19.5/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model IEnumerable<Docente>
@{ ViewData["Title"] = "Docentes"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h2>Docentes</h2><a class="btn btn-primary" asp-action="Create">Nuevo docente</a></div>
<form method="get" class="row g-2 mb-3"><div class="col-md-5"><input name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre o especialidad" /></div>
<div class="col-auto"><button class="btn btn-outline-primary">Buscar</button></div></form>
<div class="table-responsive"><table class="table table-striped bg-white align-middle">
<thead><tr><th>Nombre</th><th>Correo</th><th>Especialidad</th><th>Cursos asignados</th><th></th></tr></thead>
<tbody>
@foreach (var d in Model)
{
  <tr><td>@d.Nombre</td><td>@d.Correo</td><td>@d.Especialidad</td><td>@d.Cursos.Count</td>
  <td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id">Editar</a>
      <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@d.Id">Eliminar</a></td></tr>
}
</tbody></table></div>

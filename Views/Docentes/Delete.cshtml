@model Docente
@{ ViewData["Title"] = "Eliminar docente"; }
<h2>Eliminar docente</h2>
<div class="alert alert-warning">¿Seguro que desea eliminar a <strong>@Model.Nombre</strong>? (Cursos asignados: @Model.Cursos.Count)</div>
<form asp-action="Delete" method="post"><input type="hidden" asp-for="Id" />
  <button class="btn btn-danger" type="submit">Eliminar</button> <a class="btn btn-secondary" asp-action="Index">Cancelar</a></form>
